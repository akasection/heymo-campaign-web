APP_NAME="Heymo! Campaign Webapp"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (see _dev/docker-compose.yaml — postgres service on :5434)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=heymo
DB_USERNAME=heymo
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# JWT API access. Leave JWT_SECRET empty to use the application key locally;
# set a separate long random secret in non-local environments.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER="${APP_URL}"
JWT_AUDIENCE=heymo-campaign-web
JWT_TTL_MINUTES=120

# Passwordless sign-in.
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_LOG_CODES=true

MEMCACHED_HOST=127.0.0.1

# Valkey (see _dev/docker-compose.yaml — valkey service on :6380).
# Valkey speaks the Redis protocol, so the Redis config applies unchanged.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6380
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# OpenAI-compatible LLM provider (Together AI). Keep the key server-side.
LLM_API_URL=https://api.together.ai/v1
LLM_API_KEY=YOUR_API_KEY_HERE
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
LLM_ENDPOINT=chat/completions
LLM_TIMEOUT=30
LLM_RETRIES=1

# Structured output. Together AI supports "json_object", "json_schema", and "regex".
# "json_object" is expected here; set it empty to disable for models without JSON mode.
LLM_RESPONSE_FORMAT=json_object

# Optional Together AI moderation model (e.g. meta-llama/Meta-Llama-Guard-3-8B). Empty = disabled.
LLM_SAFETY_MODEL=

# Sampling controls. Empty values are omitted so Together AI model defaults apply.
LLM_TEMPERATURE=0.4
# 1500 fits ~100-300 words per email across the three-email JSON response. Raise to ~2500
# if emails consistently approach 300 words each, to avoid truncating the JSON mid-response.
LLM_MAX_TOKENS=1500
LLM_TOP_P=
LLM_TOP_K=
LLM_REPETITION_PENALTY=
LLM_FREQUENCY_PENALTY=
LLM_PRESENCE_PENALTY=
LLM_SEED=
LLM_STOP=
